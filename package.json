{
  "name": "hello-cigen",
  "displayName": "HELLOCIGEN – Live Share API Testing",
  "description": "Testing VS Code Live Share APIs for collaborative sessions",
  "version": "0.7.3",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.107.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:helloCigen.initialSession",
    "onView:helloCigen.sidebar",
    "onCommand:helloCigen.launch",
    "onCommand:helloCigen.start"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{
        "id": "helloCigenContainer",
        "title": "HelloCigen",
        "icon": "assets/icon.png"
      }]
    },
    "views": {
      "helloCigenContainer":[
        {
          "id": "helloCigen.initialSession",
          "name": "Welcome",
          "type": "webview"
        }
      ],
      "explorer": [
        {
          "id": "helloCigen.taskTracker",
          "name": "Task Tracker",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "helloCigen.launch",
        "title": "HELLOCIGEN: Launch HelloCigen"
      },
      {
        "command": "helloCigen.start",
        "title": "HELLOCIGEN: Create a Live Share Session"
      },
      {
        "command": "helloCigen.join",
        "title": "HELLOCIGEN: Join a Live Share Session"
      },
      {
        "command": "helloCigen.setApiKey",
        "title": "HELLOCIGEN: Set OpenAI API Key"
      },
      {
        "command": "helloCigen.clearApiKey",
        "title": "HELLOCIGEN: Clear OpenAI API Key"
      },
      {
        "command": "helloCigen.restartServer",
        "title": "HELLOCIGEN: Restart Server"
      }
    ],
    "_commented_out_commands": [
      "helloCigen.openChat — removed in Phase 5 (chatManager2 deleted, DevChatPanel is sole chat)",
      "helloCigen.openChat2 — removed in Phase 5 (same as openChat)",
      "helloCigen.sendActiveFile — removed in Phase 5 (was tied to chatManager2)"
    ],
    "menus": {
      "view/title": []
    }
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongodb": "^7.0.0",
    "node-fetch": "^2.7.0",
    "openai": "^6.15.0",
    "vsls": "^0.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.30",
    "@types/node-fetch": "^2.6.13",
    "@types/vscode": "^1.107.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run compile && npx @vscode/vsce package"
  }
}

{
  "name": "hello-cigen",
  "displayName": "HELLOCIGEN – Live Share API Testing",
  "description": "Testing VS Code Live Share APIs for collaborative sessions",
  "version": "0.0.1",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.107.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:helloCigen.sidebar",
    "onCommand:helloCigen.launch",
    "onCommand:helloCigen.start",
    "onCommand:helloCigen.openChat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [{
        "id": "helloCigenContainer",
        "title": "HelloCigen",
        "icon": "assets/icon.png"
      }]
    },
    "views": {
      "helloCigenContainer":[
        {
          "id": "helloCigen.sidebar",
          "name": "HelloCigen",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "helloCigen.launch",
        "title": "HELLOCIGEN: Launch HelloCigen"
      },
      {
        "command": "helloCigen.start",
        "title": "HELLOCIGEN: Create a Live Share Session"
      },
      {
        "command": "helloCigen.join",
        "title": "HELLOCIGEN: Join a Live Share Session"
      },
      {
        "command": "helloCigen.openChat",
        "title": "HELLOCIGEN: Open Chat"
      },
      {
        "command": "helloCigen.setApiKey",
        "title": "HELLOCIGEN: Set OpenAI API Key"
      },
      {
        "command": "helloCigen.clearApiKey",
        "title": "HELLOCIGEN: Clear OpenAI API Key"
      }
      ,
      {
        "command": "helloCigen.sendActiveFile",
        "title": "HELLOCIGEN: Send Active File to Model"
      }
    ],
    "menus": {
      "view/title": []
    }
  },
  "dependencies": {
    "express": "^5.2.1",
    "mongodb": "^7.0.0",
    "node-fetch": "^2.7.0",
    "openai": "^6.15.0",
    "vsls": "^0.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.9",
    "@types/node-fetch": "^2.6.13",
    "@types/vscode": "^1.107.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  }
}
